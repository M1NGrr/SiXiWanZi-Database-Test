# ==========================================
# 四禧丸子直播语料库 - 环境配置示例
# 复制为 .env 后填入你自己的配置（切勿提交到公开仓库）
# ==========================================

# 本地 SQLite 数据库路径（默认：./data/sixiwanzi_subtitles.db，可按需修改文件名）
ZJ_DB_PATH=data/sixiwanzi_subtitles.db

# B站登录 Cookie（抓取 B 站官方 AI 字幕 ai-zh 必须提供有效的 SESSDATA）
# 方式 1：直接粘贴浏览器里完整的 Cookie 字符串（推荐）
BILIBILI_COOKIE=

# 方式 2：也可以分别填写关键字段（若 BILIBILI_COOKIE 为空则自动拼接）
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_DEDEUSERID=
BILIBILI_BUVID3=

# 抓取限速与重试配置（避免触发 B 站风控 -352 / 412）
ZJ_REQUEST_DELAY=1.5
ZJ_REQUEST_JITTER=0.6
ZJ_MAX_RETRIES=3

# 本地 API 服务默认监听地址
ZJ_API_HOST=127.0.0.1
ZJ_API_PORT=8000

# 是否启用本地私有管理接口与调试台（本地=1；部署云端对外服务时务必设为 0）
ZJ_ENABLE_ADMIN=1

# 允许跨域访问的前端域名（逗号分隔，本地默认 *，上线后改为正式前端域名如 https://sixiwanzi.example.com）
ZJ_CORS_ORIGINS=*

# 单机一体部署时是否由 FastAPI 在 / 托管 frontend/ 静态前端（分域部署到 Cloudflare Pages 时可设为 0）
ZJ_SERVE_FRONTEND=1

# 可选：在作者信息页展示的 GitHub 开源仓库链接
ZJ_GITHUB_URL=
